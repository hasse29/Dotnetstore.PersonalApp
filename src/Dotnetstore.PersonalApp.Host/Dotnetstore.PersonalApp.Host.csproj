<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Required for `dotnet ef` when the Host is the startup project -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dotnetstore.PersonalApp.Shared\Dotnetstore.PersonalApp.Shared.csproj" />
    <ProjectReference Include="..\Modules\Contact\Dotnetstore.PersonalApp.Modules.Contact\Dotnetstore.PersonalApp.Modules.Contact.csproj" />
    <ProjectReference Include="..\Modules\Clients\Dotnetstore.PersonalApp.Modules.Clients\Dotnetstore.PersonalApp.Modules.Clients.csproj" />
    <ProjectReference Include="..\Modules\Products\Dotnetstore.PersonalApp.Modules.Products\Dotnetstore.PersonalApp.Modules.Products.csproj" />
    <ProjectReference Include="..\Modules\Sales\Dotnetstore.PersonalApp.Modules.Sales\Dotnetstore.PersonalApp.Modules.Sales.csproj" />
    <ProjectReference Include="..\Modules\TimeReports\Dotnetstore.PersonalApp.Modules.TimeReports\Dotnetstore.PersonalApp.Modules.TimeReports.csproj" />
    <ProjectReference Include="..\Modules\Cvs\Dotnetstore.PersonalApp.Modules.Cvs\Dotnetstore.PersonalApp.Modules.Cvs.csproj" />
    <ProjectReference Include="..\Modules\Students\Dotnetstore.PersonalApp.Modules.Students\Dotnetstore.PersonalApp.Modules.Students.csproj" />
    <ProjectReference Include="..\Modules\Subjects\Dotnetstore.PersonalApp.Modules.Subjects\Dotnetstore.PersonalApp.Modules.Subjects.csproj" />
    <ProjectReference Include="..\Modules\Audit\Dotnetstore.PersonalApp.Modules.Audit\Dotnetstore.PersonalApp.Modules.Audit.csproj" />
    <ProjectReference Include="..\Modules\Schedule\Dotnetstore.PersonalApp.Modules.Schedule\Dotnetstore.PersonalApp.Modules.Schedule.csproj" />
    <ProjectReference Include="..\Modules\Grades\Dotnetstore.PersonalApp.Modules.Grades\Dotnetstore.PersonalApp.Modules.Grades.csproj" />
    <ProjectReference Include="..\Modules\Email\Dotnetstore.PersonalApp.Modules.Email\Dotnetstore.PersonalApp.Modules.Email.csproj" />
    <ProjectReference Include="..\Modules\Users\Dotnetstore.PersonalApp.Modules.Users\Dotnetstore.PersonalApp.Modules.Users.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dotnetstore.PersonalApp.Integration.Tests" />
  </ItemGroup>

</Project>
