<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dotnetstore.PersonalApp.Host.App"
             xmlns:local="using:Dotnetstore.PersonalApp.Host"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Design tokens. Module views use these keys and the style classes from Styles/AdminTheme.axaml. -->
        <Color x:Key="AccentColor">#4F46E5</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#3730A3"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF"/>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>

        <SolidColorBrush x:Key="SidebarBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="SidebarActiveBrush" Color="#312E81"/>
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="SidebarMutedBrush" Color="#64748B"/>

        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>

        <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#4F46E5"/>
            <GradientStop Offset="1" Color="#7C3AED"/>
        </LinearGradientBrush>

        <local:StringToGeometryConverter x:Key="PathData"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#4F46E5" RegionColor="#FFFFFF"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Dotnetstore.PersonalApp.Host/Styles/AdminTheme.axaml"/>
    </Application.Styles>
</Application>
