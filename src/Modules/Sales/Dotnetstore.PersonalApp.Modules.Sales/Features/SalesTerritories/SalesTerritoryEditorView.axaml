<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:feat="using:Dotnetstore.PersonalApp.Modules.Sales.Features"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Sales.Features.SalesTerritories"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.Sales.Features.SalesTerritories.SalesTerritoryEditorView"
             x:DataType="vm:SalesTerritoryEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesTerritoryField_Name}" Classes="label"/>
                <TextBox Text="{Binding Name}" MaxLength="50"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesTerritoryField_CountryRegionCode}" Classes="label"/>
                <TextBox Text="{Binding CountryRegionCode}" MaxLength="10"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesTerritoryField_RegionGroup}" Classes="label"/>
                <TextBox Text="{Binding RegionGroup}" MaxLength="50"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesTerritoryField_SalesYtd}" Classes="label"/>
                <NumericUpDown Value="{Binding SalesYtd}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesTerritoryField_SalesLastYear}" Classes="label"/>
                <NumericUpDown Value="{Binding SalesLastYear}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesTerritoryField_CostYtd}" Classes="label"/>
                <NumericUpDown Value="{Binding CostYtd}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesTerritoryField_CostLastYear}" Classes="label"/>
                <NumericUpDown Value="{Binding CostLastYear}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty} }"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr SalesTerritoryEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>