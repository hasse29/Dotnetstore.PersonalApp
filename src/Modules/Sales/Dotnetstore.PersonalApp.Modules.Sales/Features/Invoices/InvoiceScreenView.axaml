<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:invoices="using:Dotnetstore.PersonalApp.Modules.Sales.Features.Invoices"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
             x:Class="Dotnetstore.PersonalApp.Modules.Sales.Features.Invoices.InvoiceScreenView"
             x:DataType="invoices:InvoiceScreenViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                        <TextBlock Text="{loc:Tr InvoiceScreen_Back}"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Heading}" Classes="h2"/>
                    <TextBlock Text="{Binding StatusText}" Classes="muted"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Tr SalesPdf_Export}" Classes="subtle" Command="{Binding ExportPdfCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding CanCancel}">
                    <Button Content="{loc:Tr InvoiceScreen_Cancel}" Classes="link-danger" Command="{Binding RequestCancelCommand}"
                            IsVisible="{Binding !IsConfirmingCancel}"/>
                    <TextBlock Text="{loc:Tr InvoiceScreen_ConfirmCancel}" VerticalAlignment="Center" Classes="muted"
                               IsVisible="{Binding IsConfirmingCancel}"/>
                    <Button Content="{loc:Tr InvoiceScreen_YesCancel}" Classes="danger" Command="{Binding ConfirmCancelCommand}"
                            IsVisible="{Binding IsConfirmingCancel}"/>
                    <Button Content="{loc:Tr InvoiceScreen_KeepInvoice}" Classes="subtle" Command="{Binding CancelCancelCommand}"
                            IsVisible="{Binding IsConfirmingCancel}"/>
                </StackPanel>
            </Grid>

            <Border Classes="card" Padding="24">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Tr InvoiceScreen_Customer}" Classes="label"/>
                        <TextBlock Text="{Binding CustomerText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding DatesText}"/>
                        <TextBlock Text="{Binding OrderText}" Classes="muted"/>
                        <TextBlock Text="{Binding Reference}" Classes="muted"
                                   IsVisible="{Binding Reference, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="card" Padding="24" IsVisible="{Binding CanPay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Tr InvoiceScreen_Payments}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <TextBlock>
                            <Run Text="{loc:Tr InvoiceScreen_Paid}" Classes="muted"/>
                            <Run Text="{Binding PaidText}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="{loc:Tr InvoiceScreen_Outstanding}" Classes="muted"/>
                            <Run Text="{Binding OutstandingText}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Payments}" IsVisible="{Binding HasPayments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="invoices:PaymentRow">
                                <Grid ColumnDefinitions="*,3*,1.2*,2*,Auto" Margin="0,4">
                                    <TextBlock Text="{Binding DateText}" Classes="muted" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ExcessText}" Classes="muted" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Classes="subtle" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((invoices:InvoiceScreenViewModel)DataContext).DeletePaymentCommand}"
                                            CommandParameter="{Binding}">
                                        <PathIcon Width="12" Height="12" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="180,180,*,Auto" ColumnSpacing="8">
                        <NumericUpDown Value="{Binding PaymentAmount}" Minimum="0" Maximum="10000000" Increment="100" FormatString="N2"
                                       ShowButtonSpinner="False" VerticalAlignment="Center"/>
                        <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding PaymentDate}" HorizontalAlignment="Stretch"/>
                        <TextBox Grid.Column="2" Text="{Binding PaymentNote}" PlaceholderText="{loc:Tr InvoiceScreen_PaymentNote}"/>
                        <Button Grid.Column="3" Content="{loc:Tr InvoiceScreen_RecordPayment}" Classes="primary" Command="{Binding RecordPaymentCommand}"/>
                    </Grid>
                    <TextBlock Text="{loc:Tr InvoiceScreen_PaymentHint}" Classes="caption" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding CanApplyCredit}">
                        <TextBlock Text="{Binding CreditText}" VerticalAlignment="Center"/>
                        <Button Content="{loc:Tr InvoiceScreen_ApplyCredit}" Classes="subtle" Command="{Binding ApplyCreditCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto">
                    <Border Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="4*,1.5*,1.3*,0.9*,1.3*">
                            <TextBlock Text="{loc:Tr InvoiceScreen_ColDescription}" Classes="column"/>
                            <TextBlock Grid.Column="1" Text="{loc:Tr InvoiceScreen_ColQuantity}" Classes="column"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr InvoiceScreen_ColPrice}" Classes="column"/>
                            <TextBlock Grid.Column="3" Text="{loc:Tr InvoiceScreen_ColVat}" Classes="column"/>
                            <TextBlock Grid.Column="4" Text="{loc:Tr InvoiceScreen_ColAmount}" Classes="column"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="invoices:InvoiceLineRow">
                                    <Grid ColumnDefinitions="4*,1.5*,1.3*,0.9*,1.3*" Margin="16,8">
                                        <TextBlock Text="{Binding Line.Description}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding QuantityText}" Classes="muted"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PriceText}" Classes="muted"/>
                                        <TextBlock Grid.Column="3" Text="{Binding VatText}" Classes="muted"/>
                                        <TextBlock Grid.Column="4" Text="{Binding AmountText}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="4" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                    <TextBlock Text="{loc:Tr InvoiceScreen_Net}" Classes="muted"/>
                                    <TextBlock Text="{Binding NetText}" MinWidth="100" TextAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                    <TextBlock Text="{loc:Tr InvoiceScreen_Vat}" Classes="muted"/>
                                    <TextBlock Text="{Binding VatText}" MinWidth="100" TextAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                    <TextBlock Text="{loc:Tr InvoiceScreen_Total}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalText}" MinWidth="100" TextAlignment="Right" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Classes="caption" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
    </ScrollViewer>

</UserControl>
