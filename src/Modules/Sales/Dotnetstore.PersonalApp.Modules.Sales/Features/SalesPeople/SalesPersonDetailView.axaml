<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Sales.Features.SalesPeople"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Sales.Features.SalesPeople.SalesPersonDetailView"
             x:DataType="vm:SalesPersonDetailViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    <TextBlock Text="{loc:Tr SalesPersonDetail_Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding SalesPerson.Name}" Classes="h2"/>
                <TextBlock Text="{Binding SalesPerson.TerritoryName}" Classes="muted"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Padding="0">
            <TabItem Header="{loc:Tr SalesPersonDetail_TabInformation}">
                <Border Classes="card" Padding="28" Margin="0,20,0,0" VerticalAlignment="Top">
                    <WrapPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr SalesPersonField_Name}" Classes="label"/>
                            <TextBlock Text="{Binding SalesPerson.Name}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr SalesPersonField_User}" Classes="label"/>
                            <TextBlock Text="{Binding SalesPerson.UserName}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr SalesPersonField_Territory}" Classes="label"/>
                            <TextBlock Text="{Binding SalesPerson.TerritoryName}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr SalesPersonField_SalesQuota}" Classes="label"/>
                            <TextBlock Text="{Binding SalesPerson.SalesQuota, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr SalesPersonField_Bonus}" Classes="label"/>
                            <TextBlock Text="{Binding SalesPerson.Bonus, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr SalesPersonField_CommissionPct}" Classes="label"/>
                            <TextBlock Text="{Binding SalesPerson.CommissionPct, StringFormat={}{0:P1}}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr SalesPersonField_SalesYtd}" Classes="label"/>
                            <TextBlock Text="{Binding SalesPerson.SalesYtd, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr SalesPersonField_SalesLastYear}" Classes="label"/>
                            <TextBlock Text="{Binding SalesPerson.SalesLastYear, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </TabItem>

            <TabItem Header="{loc:Tr SalesPersonDetail_TabQuotaHistory}">
                <ContentControl Content="{Binding QuotaHistory}" Margin="0,20,0,0"/>
            </TabItem>
            <TabItem Header="{loc:Tr SalesPersonDetail_TabTerritoryHistory}">
                <ContentControl Content="{Binding TerritoryHistory}" Margin="0,20,0,0"/>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
