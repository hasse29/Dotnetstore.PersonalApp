<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:customers="using:Dotnetstore.PersonalApp.Modules.Sales.Features.Customers"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="420"
             x:Class="Dotnetstore.PersonalApp.Modules.Sales.Features.Customers.CustomerSalesHistoryView"
             x:DataType="customers:CustomerSalesHistoryViewModel">

    <StackPanel Spacing="20">

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <Border Classes="card" Padding="16">
                <StackPanel>
                    <TextBlock Text="{loc:Tr SalesHistory_Invoiced}" Classes="label"/>
                    <TextBlock Text="{Binding InvoicedText}" Classes="h2"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="16">
                <StackPanel>
                    <TextBlock Text="{loc:Tr SalesHistory_Paid}" Classes="label"/>
                    <TextBlock Text="{Binding PaidText}" Classes="h2"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="16">
                <StackPanel>
                    <TextBlock Text="{loc:Tr SalesHistory_Outstanding}" Classes="label"/>
                    <TextBlock Text="{Binding OutstandingText}" Classes="h2"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <Border Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="1*,1.5*,1.5*,1*,1*,1*">
                        <TextBlock Text="{loc:Tr SalesHistory_ColType}" Classes="column"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr SalesHistory_ColNumber}" Classes="column"/>
                        <TextBlock Grid.Column="2" Text="{loc:Tr SalesHistory_ColFrom}" Classes="column"/>
                        <TextBlock Grid.Column="3" Text="{loc:Tr SalesHistory_ColDate}" Classes="column"/>
                        <TextBlock Grid.Column="4" Text="{loc:Tr SalesHistory_ColStatus}" Classes="column"/>
                        <TextBlock Grid.Column="5" Text="{loc:Tr SalesHistory_ColTotal}" Classes="column"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="customers:SalesHistoryRow">
                                <Grid ColumnDefinitions="1*,1.5*,1.5*,1*,1*,1*" Margin="16,8">
                                    <TextBlock Text="{Binding KindText}" Classes="muted"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Entry.Number}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FromText}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DateText}" Classes="muted"/>
                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" Classes="muted"/>
                                    <TextBlock Grid.Column="5" Text="{Binding TotalText}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </StackPanel>

</UserControl>
