<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Sales.Features.Customers"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Sales.Features.Customers.CustomerDetailView"
             x:DataType="vm:CustomerDetailViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    <TextBlock Text="{loc:Tr CustomerDetail_Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Customer.Name}" Classes="h2"/>
                <TextBlock Text="{Binding Customer.Number}" Classes="muted"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Padding="0">
            <TabItem Header="{loc:Tr CustomerDetail_TabInformation}">
                <Border Classes="card" Padding="28" Margin="0,20,0,0" VerticalAlignment="Top">
                    <WrapPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr CustomerField_Number}" Classes="label"/>
                            <TextBlock Text="{Binding Customer.Number}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr CustomerField_Name}" Classes="label"/>
                            <TextBlock Text="{Binding Customer.Name}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr CustomerField_Client}" Classes="label"/>
                            <TextBlock Text="{Binding Customer.ClientName}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr CustomerField_Store}" Classes="label"/>
                            <TextBlock Text="{Binding Customer.StoreName}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr CustomerField_Territory}" Classes="label"/>
                            <TextBlock Text="{Binding Customer.TerritoryName}"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </TabItem>

            <TabItem Header="{loc:Tr CustomerDetail_TabSalesOrders}">
                <ContentControl Content="{Binding SalesOrders}" Margin="0,20,0,0"/>
            </TabItem>

            <TabItem Header="{loc:Tr CustomerDetail_TabAddresses}"
                     IsVisible="{Binding Addresses, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Addresses}" Margin="0,20,0,0"/>
            </TabItem>
            <TabItem Header="{loc:Tr CustomerDetail_TabEmailAddresses}"
                     IsVisible="{Binding EmailAddresses, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding EmailAddresses}" Margin="0,20,0,0"/>
            </TabItem>
            <TabItem Header="{loc:Tr CustomerDetail_TabPhoneNumbers}"
                     IsVisible="{Binding PhoneNumbers, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding PhoneNumbers}" Margin="0,20,0,0"/>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
