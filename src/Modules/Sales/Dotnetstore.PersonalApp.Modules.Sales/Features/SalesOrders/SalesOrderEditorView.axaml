<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:feat="using:Dotnetstore.PersonalApp.Modules.Sales.Features"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Sales.Features.SalesOrders"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.Sales.Features.SalesOrders.SalesOrderEditorView"
             x:DataType="vm:SalesOrderEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_Number}" Classes="label"/>
                <TextBox Text="{Binding Number}" MaxLength="25"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_Status}" Classes="label"/>
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:ChoiceOption">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <CheckBox IsChecked="{Binding OnlineOrderFlag}" Content="{loc:Tr SalesOrderField_OnlineOrderFlag}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_OrderDate}" Classes="label"/>
                <CalendarDatePicker SelectedDate="{Binding OrderDate}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_DueDate}" Classes="label"/>
                <CalendarDatePicker SelectedDate="{Binding DueDate}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_ShipDate}" Classes="label"/>
                <CalendarDatePicker SelectedDate="{Binding ShipDate}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_PurchaseOrderNumber}" Classes="label"/>
                <TextBox Text="{Binding PurchaseOrderNumber}" MaxLength="25"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding !IsParentFixed}">
                <TextBlock Text="{loc:Tr SalesOrderField_Customer}" Classes="label"/>
                <ComboBox ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding SelectedCustomer}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_SalesPerson}" Classes="label"/>
                <ComboBox ItemsSource="{Binding SalesPersonOptions}" SelectedItem="{Binding SelectedSalesPerson}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_Territory}" Classes="label"/>
                <ComboBox ItemsSource="{Binding TerritoryOptions}" SelectedItem="{Binding SelectedTerritory}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_ShipMethod}" Classes="label"/>
                <ComboBox ItemsSource="{Binding ShipMethodOptions}" SelectedItem="{Binding SelectedShipMethod}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_TaxAmt}" Classes="label"/>
                <NumericUpDown Value="{Binding TaxAmt}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_Freight}" Classes="label"/>
                <NumericUpDown Value="{Binding Freight}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SalesOrderField_Comment}" Classes="label"/>
                <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160" MaxLength="128"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty} }"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr SalesOrderEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>