<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:picks="using:Dotnetstore.PersonalApp.Modules.Sales.Features.PickLists"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Sales.Features.PickLists.PickListScreenView"
             x:DataType="picks:PickListScreenViewModel">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    <TextBlock Text="{loc:Tr PickListScreen_Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Heading}" Classes="h2"/>
                <TextBlock Classes="muted">
                    <Run Text="{Binding CustomerName}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding StatusText}"/>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="2" Content="{loc:Tr PickListScreen_PickAll}" Classes="subtle" Command="{Binding PickAllCommand}"
                    IsVisible="{Binding IsEditable}" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Classes="card">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="3*,1.4*,1.6*,1.2*">
                        <TextBlock Text="{loc:Tr PickListScreen_ColProduct}" Classes="column"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr PickListScreen_ColOrdered}" Classes="column"/>
                        <TextBlock Grid.Column="2" Text="{loc:Tr PickListScreen_ColPicked}" Classes="column"/>
                        <TextBlock Grid.Column="3" Text="{loc:Tr PickListScreen_ColRemaining}" Classes="column"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="picks:PickListLineRow">
                                <Grid ColumnDefinitions="3*,1.4*,1.6*,1.2*" Margin="16,4">
                                    <TextBlock Text="{Binding Line.Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OrderedText}" Classes="muted" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding PickedQuantity}" Minimum="0" Maximum="1000000"
                                                   Increment="1" FormatString="0.##" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   IsEnabled="{Binding IsEditable}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RemainingText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="{loc:Tr PickListScreen_Save}" Classes="primary" Command="{Binding SaveCommand}"
                    IsVisible="{Binding IsEditable}"/>
        </Grid>
    </Grid>

</UserControl>
