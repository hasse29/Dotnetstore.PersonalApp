<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:orders="using:Dotnetstore.PersonalApp.Modules.Sales.Features.Orders"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Sales.Features.Orders.OrdersView"
             x:DataType="orders:OrdersViewModel">

    <Grid Margin="28">

        <ContentControl Content="{Binding Screen}" IsVisible="{Binding HasScreen}"/>

        <Grid RowDefinitions="Auto,*" RowSpacing="20" IsVisible="{Binding !HasScreen}">

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Orders_Title}" Classes="h1"/>
                <TextBlock Text="{loc:Tr Orders_Subtitle}" Classes="muted"/>
            </StackPanel>

            <Border Grid.Row="1" Classes="card">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <Grid ColumnDefinitions="*,200,Auto" ColumnSpacing="8" Margin="16">
                        <TextBox Text="{Binding Search}" PlaceholderText="{loc:Tr Orders_SearchPlaceholder}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="orders:OrderStatusOption">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" Content="{loc:Tr Orders_Search}" Classes="subtle" Command="{Binding LoadCommand}"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                        <Grid ColumnDefinitions="1.3*,2*,1*,1.2*,1.4*,1.2*">
                            <TextBlock Text="{loc:Tr Orders_ColNumber}" Classes="column"/>
                            <TextBlock Grid.Column="1" Text="{loc:Tr Orders_ColCustomer}" Classes="column"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr Orders_ColDate}" Classes="column"/>
                            <TextBlock Grid.Column="3" Text="{loc:Tr Orders_ColStatus}" Classes="column"/>
                            <TextBlock Grid.Column="4" Text="{loc:Tr Orders_ColPicking}" Classes="column"/>
                            <TextBlock Grid.Column="5" Text="{loc:Tr Orders_ColTotal}" Classes="column"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" Classes="table" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="orders:OrderRow">
                                <Grid ColumnDefinitions="1.3*,2*,1*,1.2*,1.4*,1.2*">
                                    <TextBlock Text="{Binding Order.Number}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Order.CustomerName}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Classes="muted"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Classes="muted"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PickText}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="5" Text="{Binding TotalText}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>
