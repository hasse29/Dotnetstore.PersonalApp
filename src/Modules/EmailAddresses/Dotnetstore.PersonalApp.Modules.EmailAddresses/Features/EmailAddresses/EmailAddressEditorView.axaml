<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:emails="using:Dotnetstore.PersonalApp.Modules.EmailAddresses.Features.EmailAddresses"
             xmlns:types="using:Dotnetstore.PersonalApp.Modules.EmailAddresses.Features.EmailAddressTypes"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="320"
             x:Class="Dotnetstore.PersonalApp.Modules.EmailAddresses.Features.EmailAddresses.EmailAddressEditorView"
             x:DataType="emails:EmailAddressEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr EmailAddressField_Type}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="types:EmailAddressTypeDto">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr EmailAddressField_Email}" Classes="label"/>
                <TextBox Text="{Binding Email}" PlaceholderText="{loc:Tr EmailAddressField_EmailPlaceholder}"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr EmailAddressEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>