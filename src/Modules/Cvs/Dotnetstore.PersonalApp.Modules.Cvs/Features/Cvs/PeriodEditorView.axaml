<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cvs="using:Dotnetstore.PersonalApp.Modules.Cvs.Features.Cvs"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.Cvs.Features.Cvs.PeriodEditorView"
             x:DataType="cvs:PeriodEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel>
                <TextBlock Text="{Binding OrganisationLabel}" Classes="label"/>
                <TextBox Text="{Binding Organisation}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{Binding PositionLabel}" Classes="label"/>
                <TextBox Text="{Binding Position}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr CvField_StartDate}" Classes="label"/>
                    <CalendarDatePicker SelectedDate="{Binding StartDate}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr CvField_EndDate}" Classes="label"/>
                    <CalendarDatePicker SelectedDate="{Binding EndDate}" HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding !IsOngoing}"/>
                </StackPanel>
            </Grid>
            <CheckBox IsChecked="{Binding IsOngoing}" Content="{loc:Tr CvField_Ongoing}"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr CvField_Description}" Classes="label"/>
                <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowTechnologies}">
                <TextBlock Text="{loc:Tr CvField_Technologies}" Classes="label"/>
                <TextBox Text="{Binding Technologies}" PlaceholderText="{loc:Tr CvField_TechnologiesPlaceholder}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="60" MaxHeight="120"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanDelete}">
                    <Button Content="{loc:Tr CvSectionEditor_Delete}" Classes="link-danger" Command="{Binding RequestDeleteCommand}"
                            IsVisible="{Binding !IsConfirmingDelete}"/>
                    <TextBlock Text="{loc:Tr CvSectionEditor_ConfirmDelete}" VerticalAlignment="Center" Classes="muted"
                               IsVisible="{Binding IsConfirmingDelete}"/>
                    <Button Content="{loc:Tr CvSectionEditor_YesDelete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                            IsVisible="{Binding IsConfirmingDelete}"/>
                    <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelDeleteCommand}"
                            IsVisible="{Binding IsConfirmingDelete}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                    <Button Content="{loc:Tr CvSectionEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>

</UserControl>
