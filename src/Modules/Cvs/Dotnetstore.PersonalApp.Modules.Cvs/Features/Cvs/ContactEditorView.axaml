<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cvs="using:Dotnetstore.PersonalApp.Modules.Cvs.Features.Cvs"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.Cvs.Features.Cvs.ContactEditorView"
             x:DataType="cvs:ContactEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <TextBlock Text="{loc:Tr CvContactEditor_Hint}" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Tr CvContactEditor_Empty}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoOptions}"/>
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="cvs:ContactOption">
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Caption}" Classes="caption"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr CvSectionEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
