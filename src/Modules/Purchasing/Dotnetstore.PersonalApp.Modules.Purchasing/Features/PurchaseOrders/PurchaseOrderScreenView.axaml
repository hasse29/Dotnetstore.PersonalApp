<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Purchasing.Features.PurchaseOrders"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Dotnetstore.PersonalApp.Modules.Purchasing.Features.PurchaseOrders.PurchaseOrderScreenView"
             x:DataType="vm:PurchaseOrderScreenViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    <TextBlock Text="{loc:Tr PurchaseOrderScreen_Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Order.Number}" Classes="h2"/>
                <TextBlock Text="{Binding Order.VendorName}" Classes="muted"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="380,*" ColumnSpacing="20">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="16">

                <Border Classes="card" Padding="20">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr PurchaseOrderField_SubTotal}" Classes="label"/>
                            <TextBlock Text="{Binding Order.SubTotal, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Tr PurchaseOrderField_TaxAmt}" Classes="label"/>
                            <TextBlock Text="{Binding Order.TaxAmt, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Tr PurchaseOrderField_Freight}" Classes="label"/>
                            <TextBlock Text="{Binding Order.Freight, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{loc:Tr PurchaseOrderField_TotalDue}" Classes="label"/>
                            <TextBlock Text="{Binding Order.TotalDue, StringFormat={}{0:N2}}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="{loc:Tr PurchaseOrderScreen_Lines}" Classes="h2"/>

                <ContentControl Grid.Row="2" Content="{Binding Lines}"/>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
