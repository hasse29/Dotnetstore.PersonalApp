<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tests="using:Dotnetstore.PersonalApp.Modules.Grades.Features.Tests"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="Dotnetstore.PersonalApp.Modules.Grades.Features.Tests.TestsView"
             x:DataType="tests:TestsViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20" Margin="28">

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Tests_Title}" Classes="h1"/>
                <TextBlock Text="{loc:Tr Tests_Subtitle}" Classes="muted"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                    <TextBlock Text="{loc:Tr Tests_New}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,440" ColumnSpacing="20">

            <!-- test table -->
            <Border Classes="card">
                <Grid RowDefinitions="Auto,*,Auto">

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="1.2*,2.5*,1.2*,1*">
                            <TextBlock Text="{loc:Tr Tests_ColDate}" Classes="column"/>
                            <TextBlock Grid.Column="1" Text="{loc:Tr Tests_ColName}" Classes="column"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr Tests_ColMaxScore}" Classes="column"/>
                            <TextBlock Grid.Column="3" Text="{loc:Tr Tests_ColResults}" Classes="column"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" Classes="table" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedTest}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="tests:TestDto">
                                <Grid ColumnDefinitions="1.2*,2.5*,1.2*,1*">
                                    <TextBlock Text="{Binding Date, StringFormat={}{0:d}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MaxScore}" Classes="muted"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ResultCount}" Classes="muted"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Tr Tests_Delete}" Classes="link-danger" Command="{Binding RequestDeleteCommand}"
                                        IsVisible="{Binding !IsConfirmingDelete}"/>
                                <TextBlock Text="{loc:Tr Tests_ConfirmDelete}" VerticalAlignment="Center" Classes="muted"
                                           IsVisible="{Binding IsConfirmingDelete}"/>
                                <Button Content="{loc:Tr Tests_YesDelete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                                        IsVisible="{Binding IsConfirmingDelete}"/>
                                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelDeleteCommand}"
                                        IsVisible="{Binding IsConfirmingDelete}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor and results / empty state -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel Spacing="20" VerticalAlignment="Top">
                        <ContentControl Content="{Binding Editor}"/>
                        <ContentControl Content="{Binding Results}"/>
                    </StackPanel>

                    <Border Classes="card" Padding="28" VerticalAlignment="Top"
                            IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <PathIcon Width="36" Height="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                      Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
                            <TextBlock Text="{loc:Tr Tests_NoSelection}" Classes="h2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tests_NoSelectionHint}"
                                       Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
