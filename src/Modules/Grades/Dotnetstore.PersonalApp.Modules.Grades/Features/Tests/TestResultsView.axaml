<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tests="using:Dotnetstore.PersonalApp.Modules.Grades.Features.Tests"
             xmlns:scales="using:Dotnetstore.PersonalApp.Modules.Grades.Features.Scales"
             xmlns:students="using:Dotnetstore.PersonalApp.Shared.Students"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Grades.Features.Tests.TestResultsView"
             x:DataType="tests:TestResultsViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{loc:Tr TestResults_Title}" Classes="h2"/>

            <!-- results table -->
            <Border Background="{DynamicResource SurfaceMutedBrush}" Padding="12,8"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="2*,1.4*,0.8*">
                    <TextBlock Text="{loc:Tr TestResults_ColStudent}" Classes="column"/>
                    <TextBlock Grid.Column="1" Text="{loc:Tr TestResults_ColScore}" Classes="column"/>
                    <TextBlock Grid.Column="2" Text="{loc:Tr TestResults_ColGrade}" Classes="column"/>
                </Grid>
            </Border>

            <ListBox Classes="table" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" MaxHeight="260">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="tests:TestResultRow">
                        <Grid ColumnDefinitions="2*,1.4*,0.8*">
                            <TextBlock Text="{Binding StudentName}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding ScoreDisplay}" Classes="muted"/>
                            <TextBlock Grid.Column="2" Text="{Binding GradeDisplay}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding StatusMessage}" Classes="caption" TextWrapping="Wrap"/>

            <!-- result form -->
            <StackPanel>
                <TextBlock Text="{loc:Tr TestResultField_Student}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="students:StudentReference">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{Binding ScoreLabel}" Classes="label"/>
                <TextBox Text="{Binding ScoreInput}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr TestResultField_Scale}" Classes="label"/>
                    <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="scales:GradeScaleDto">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr TestResultField_Grade}" Classes="label"/>
                    <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="scales:GradeScaleItemDto">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                <Button Content="{loc:Tr TestResults_Delete}" Classes="link-danger" Command="{Binding DeleteCommand}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr TestResults_Clear}" Classes="subtle" Command="{Binding ClearCommand}"/>
                    <Button Content="{loc:Tr TestResults_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>

</UserControl>
