<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:students="using:Dotnetstore.PersonalApp.Modules.Students.Features.Students"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.Students.Features.Students.StudentDetailView"
             x:DataType="students:StudentDetailViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    <TextBlock Text="{loc:Tr StudentDetail_Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Student.FullName}" Classes="h2"/>
                <TextBlock Text="{Binding Student.ClassName}" Classes="muted"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Padding="0">
            <TabItem Header="{loc:Tr StudentDetail_TabInformation}">
                <Border Classes="card" Padding="28" Margin="0,20,0,0" VerticalAlignment="Top">
                    <StackPanel Spacing="18">
                        <ContentControl Content="{Binding Photo}" HorizontalAlignment="Left"/>
                        <StackPanel IsVisible="{Binding Student.SchoolName, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{loc:Tr StudentField_School}" Classes="label"/>
                            <TextBlock Text="{Binding Student.SchoolName}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr StudentField_FirstName}" Classes="label"/>
                                <TextBlock Text="{Binding Student.FirstName}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Tr StudentField_LastName}" Classes="label"/>
                                <TextBlock Text="{Binding Student.LastName}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr StudentField_ClassName}" Classes="label"/>
                            <TextBlock Text="{Binding Student.ClassName}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr StudentField_Notes}" Classes="label"/>
                            <TextBlock Text="{Binding Student.Notes}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="{loc:Tr StudentDetail_TabNotes}"
                     IsVisible="{Binding Notes, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Notes}" Margin="0,20,0,0"/>
            </TabItem>

            <TabItem Header="{loc:Tr StudentDetail_TabGrades}"
                     IsVisible="{Binding Grades, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Grades}" Margin="0,20,0,0"/>
            </TabItem>

            <TabItem Header="{loc:Tr StudentDetail_TabAddresses}"
                     IsVisible="{Binding Addresses, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Addresses}" Margin="0,20,0,0"/>
            </TabItem>
            <TabItem Header="{loc:Tr StudentDetail_TabEmailAddresses}"
                     IsVisible="{Binding EmailAddresses, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding EmailAddresses}" Margin="0,20,0,0"/>
            </TabItem>
            <TabItem Header="{loc:Tr StudentDetail_TabPhoneNumbers}"
                     IsVisible="{Binding PhoneNumbers, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding PhoneNumbers}" Margin="0,20,0,0"/>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
