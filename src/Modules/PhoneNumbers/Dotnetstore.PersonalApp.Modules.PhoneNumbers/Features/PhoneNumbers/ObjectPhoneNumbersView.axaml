<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:addresses="using:Dotnetstore.PersonalApp.Modules.PhoneNumbers.Features.PhoneNumbers"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.PhoneNumbers.Features.PhoneNumbers.ObjectPhoneNumbersView"
             x:DataType="addresses:ObjectPhoneNumbersViewModel">

    <Grid ColumnDefinitions="*,380" ColumnSpacing="20">

        <!-- PhoneNumber table -->
        <Border Classes="card" VerticalAlignment="Top">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                <Grid ColumnDefinitions="*,Auto" Margin="16">
                    <TextBlock Text="{loc:Tr PhoneNumbersPanel_Title}" Classes="h2" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="14" Height="14" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                            <TextBlock Text="{loc:Tr PhoneNumbersPanel_New}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                    <Grid ColumnDefinitions="*,2*">
                        <TextBlock Text="{loc:Tr PhoneNumbersPanel_ColType}" Classes="column"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr PhoneNumbersPanel_ColNumber}" Classes="column"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="2" Classes="table" MinHeight="120" ItemsSource="{Binding PhoneNumbers}"
                         SelectedItem="{Binding SelectedPhoneNumber}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="addresses:PhoneNumberDto">
                            <Grid ColumnDefinitions="*,2*">
                                <TextBlock Text="{Binding PhoneNumberTypeName}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Tr PhoneNumbersPanel_Delete}" Classes="link-danger" Command="{Binding RequestDeleteCommand}"
                                    IsVisible="{Binding IsIdle}"/>
                            <Button Content="{loc:Tr PhoneNumbersPanel_DeleteAll}" Classes="link-danger" Command="{Binding RequestDeleteAllCommand}"
                                    IsVisible="{Binding IsIdle}"/>

                            <TextBlock Text="{loc:Tr PhoneNumbersPanel_ConfirmDelete}" VerticalAlignment="Center" Classes="muted"
                                       IsVisible="{Binding IsConfirmingDelete}"/>
                            <Button Content="{loc:Tr PhoneNumbersPanel_YesDelete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                                    IsVisible="{Binding IsConfirmingDelete}"/>

                            <TextBlock Text="{loc:Tr PhoneNumbersPanel_ConfirmDeleteAll}" VerticalAlignment="Center" Classes="muted"
                                       IsVisible="{Binding IsConfirmingDeleteAll}"/>
                            <Button Content="{loc:Tr PhoneNumbersPanel_YesDeleteAll}" Classes="danger" Command="{Binding ConfirmDeleteAllCommand}"
                                    IsVisible="{Binding IsConfirmingDeleteAll}"/>

                            <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelDeleteCommand}"
                                    IsVisible="{Binding !IsIdle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Editor / empty state -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>

                <Border Classes="card" Padding="28" VerticalAlignment="Top"
                        IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <PathIcon Width="36" Height="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                  Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                        <TextBlock Text="{loc:Tr PhoneNumbersPanel_NoSelection}" Classes="h2" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr PhoneNumbersPanel_NoSelectionHint}"
                                   Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>
