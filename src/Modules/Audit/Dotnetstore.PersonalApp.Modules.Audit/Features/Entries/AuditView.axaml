<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Entries="using:Dotnetstore.PersonalApp.Modules.Audit.Features.Entries"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Audit.Features.Entries.AuditView"
             x:DataType="Entries:AuditViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="20">

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Audit_Title}" Classes="h1"/>
            <TextBlock Text="{loc:Tr Audit_Subtitle}" Classes="muted"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="card">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" Margin="16">
                    <TextBox Text="{Binding Search}" PlaceholderText="{loc:Tr Audit_SearchPlaceholder}"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding OnlyChanges}" Content="{loc:Tr Audit_OnlyChanges}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="2" IsChecked="{Binding OnlyFailed}" Content="{loc:Tr Audit_OnlyFailed}" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="{loc:Tr Audit_Search}" Classes="subtle" Command="{Binding LoadCommand}"/>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                    <Grid ColumnDefinitions="150,110,220,*,2*,110">
                        <TextBlock Text="{loc:Tr Audit_ColWhen}" Classes="column"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr Audit_ColUser}" Classes="column"/>
                        <TextBlock Grid.Column="2" Text="{loc:Tr Audit_ColOperation}" Classes="column"/>
                        <TextBlock Grid.Column="3" Text="{loc:Tr Audit_ColEntity}" Classes="column"/>
                        <TextBlock Grid.Column="4" Text="{loc:Tr Audit_ColFields}" Classes="column"/>
                        <TextBlock Grid.Column="5" Text="{loc:Tr Audit_ColOutcome}" Classes="column"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="2" Classes="table" ItemsSource="{Binding Entries}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="Entries:AuditEntryDto">
                            <Grid ColumnDefinitions="150,110,220,*,2*,110">
                                <TextBlock Text="{Binding When}" Classes="muted"/>
                                <TextBlock Grid.Column="1" Text="{Binding User}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Operation}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Entity}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="4" Text="{Binding Fields}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="5" Text="{Binding Outcome}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
