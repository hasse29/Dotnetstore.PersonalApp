<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:persons="using:Dotnetstore.PersonalApp.Modules.Clients.Features.ContactPersons"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="480"
             x:Class="Dotnetstore.PersonalApp.Modules.Clients.Features.ContactPersons.ContactPersonsView"
             x:DataType="persons:ContactPersonsViewModel">

    <Panel>
        <Grid RowDefinitions="Auto,*" RowSpacing="16"
              IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Tr ContactPersons_Subtitle}" Classes="muted" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                        <TextBlock Text="{loc:Tr ContactPersons_New}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,380" ColumnSpacing="20">

                <Border Classes="card">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,*">
                                <TextBlock Text="{loc:Tr ContactPersons_ColName}" Classes="column"/>
                                <TextBlock Grid.Column="1" Text="{loc:Tr ContactPersons_ColJobTitle}" Classes="column"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" Classes="table" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="persons:ContactPersonDto">
                                    <Grid ColumnDefinitions="*,*">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding JobTitle}" Classes="muted"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr ContactPersons_Details}" Classes="subtle" Command="{Binding OpenDetailCommand}"
                                            IsVisible="{Binding !IsConfirmingDelete}"/>
                                    <Button Content="{loc:Tr ContactPersons_Delete}" Classes="link-danger" Command="{Binding RequestDeleteCommand}"
                                            IsVisible="{Binding !IsConfirmingDelete}"/>
                                    <TextBlock Text="{loc:Tr ContactPersons_ConfirmDelete}" VerticalAlignment="Center" Classes="muted"
                                               IsVisible="{Binding IsConfirmingDelete}"/>
                                    <Button Content="{loc:Tr ContactPersons_YesDelete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                                            IsVisible="{Binding IsConfirmingDelete}"/>
                                    <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelDeleteCommand}"
                                            IsVisible="{Binding IsConfirmingDelete}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>

                        <Border Classes="card" Padding="28" VerticalAlignment="Top"
                                IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="{loc:Tr ContactPersons_NoSelection}" Classes="h2" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr ContactPersons_NoSelectionHint}"
                                           Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <ContentControl Content="{Binding Detail}"/>
    </Panel>

</UserControl>
