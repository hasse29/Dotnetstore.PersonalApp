<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:clients="using:Dotnetstore.PersonalApp.Modules.Clients.Features.Clients"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="700"
             x:Class="Dotnetstore.PersonalApp.Modules.Clients.Features.Clients.ClientEditorView"
             x:DataType="clients:ClientEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr ClientField_Name}" Classes="label"/>
                <TextBox Text="{Binding Name}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr ClientField_OrganizationNumber}" Classes="label"/>
                    <TextBox Text="{Binding OrganizationNumber}" PlaceholderText="{loc:Tr ClientField_OrganizationNumberPlaceholder}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr ClientField_VatNumber}" Classes="label"/>
                    <TextBox Text="{Binding VatNumber}"/>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr ClientField_Email}" Classes="label"/>
                    <TextBox Text="{Binding Email}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr ClientField_Phone}" Classes="label"/>
                    <TextBox Text="{Binding Phone}"/>
                </StackPanel>
            </Grid>

            <StackPanel>
                <TextBlock Text="{loc:Tr ClientField_Website}" Classes="label"/>
                <TextBox Text="{Binding Website}" PlaceholderText="{loc:Tr ClientField_WebsitePlaceholder}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ClientField_Notes}" Classes="label"/>
                <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="140"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr ClientEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
