<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:addresses="using:Dotnetstore.PersonalApp.Modules.Contact.Addresses.Features.Addresses"
             xmlns:types="using:Dotnetstore.PersonalApp.Modules.Contact.Addresses.Features.AddressTypes"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="640"
             x:Class="Dotnetstore.PersonalApp.Modules.Contact.Addresses.Features.Addresses.AddressEditorView"
             x:DataType="addresses:AddressEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr AddressField_Type}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="types:AddressTypeDto">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr AddressField_CareOf}" Classes="label"/>
                <TextBox Text="{Binding CareOf}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr AddressField_Street1}" Classes="label"/>
                <TextBox Text="{Binding Street1}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr AddressField_Street2}" Classes="label"/>
                <TextBox Text="{Binding Street2}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr AddressField_PostalCode}" Classes="label"/>
                    <TextBox Text="{Binding PostalCode}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr AddressField_City}" Classes="label"/>
                    <TextBox Text="{Binding City}"/>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr AddressField_State}" Classes="label"/>
                    <TextBox Text="{Binding State}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr AddressField_Country}" Classes="label"/>
                    <TextBox Text="{Binding Country}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr AddressEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
