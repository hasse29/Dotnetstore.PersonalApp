<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:reports="using:Dotnetstore.PersonalApp.Modules.TimeReports.Features.TimeReports"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="560"
             x:Class="Dotnetstore.PersonalApp.Modules.TimeReports.Features.TimeReports.SendTimeReportView"
             x:DataType="reports:SendTimeReportViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2" TextWrapping="Wrap"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr SendTimeReport_Recipient}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Recipients}" SelectedItem="{Binding SelectedRecipient}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="reports:RecipientOption">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SendTimeReport_Address}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="reports:EmailAddressOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Tr SendTimeReport_NoAddresses}" Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                           IsVisible="{Binding HasNoAddresses}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SendTimeReport_Subject}" Classes="label"/>
                <TextBox Text="{Binding Subject}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr SendTimeReport_Body}" Classes="label"/>
                <TextBox Text="{Binding Body}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr SendTimeReport_Send}" Classes="primary" Command="{Binding SendCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
