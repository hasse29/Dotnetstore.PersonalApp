<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:expenses="using:Dotnetstore.PersonalApp.Modules.TimeReports.Features.Expenses"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.TimeReports.Features.Expenses.ExpensesView"
             x:DataType="expenses:ExpensesViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20" Margin="28">

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Expenses_Title}" Classes="h1"/>
                <TextBlock Text="{loc:Tr Expenses_Subtitle}" Classes="muted"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                    <TextBlock Text="{loc:Tr Expenses_New}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,380" ColumnSpacing="20">

            <!-- Expense table -->
            <Border Classes="card" VerticalAlignment="Top">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

                    <Border Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="32">
                            <Button Content="{loc:Tr Expenses_Delete}" Classes="link-danger" Command="{Binding RequestDeleteCommand}"
                                    IsVisible="{Binding !IsConfirmingDelete}"/>
                            <TextBlock Text="{loc:Tr Expenses_ConfirmDelete}" VerticalAlignment="Center" Classes="muted"
                                       IsVisible="{Binding IsConfirmingDelete}"/>
                            <Button Content="{loc:Tr Expenses_YesDelete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                                    IsVisible="{Binding IsConfirmingDelete}"/>
                            <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelDeleteCommand}"
                                    IsVisible="{Binding IsConfirmingDelete}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                        <Grid ColumnDefinitions="1.1*,1.1*,2*,1.4*,1*,0.6*">
                            <TextBlock Text="{loc:Tr Expenses_ColDate}" Classes="column"/>
                            <TextBlock Grid.Column="1" Text="{loc:Tr Expenses_ColCategory}" Classes="column"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr Expenses_ColDescription}" Classes="column"/>
                            <TextBlock Grid.Column="3" Text="{loc:Tr Expenses_ColClient}" Classes="column"/>
                            <TextBlock Grid.Column="4" Text="{loc:Tr Expenses_ColAmount}" Classes="column"/>
                            <TextBlock Grid.Column="5" Text="{loc:Tr Expenses_ColReceipt}" Classes="column"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" Classes="table" MinHeight="120" ItemsSource="{Binding Expenses}"
                             SelectedItem="{Binding SelectedExpense}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="expenses:ExpenseRow">
                                <Grid ColumnDefinitions="1.1*,1.1*,2*,1.4*,1*,0.6*">
                                    <TextBlock Text="{Binding Expense.Date, StringFormat='{}{0:yyyy-MM-dd}'}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Expense.Description}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Expense.ClientName}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Expense.Amount, StringFormat='{}{0:N2}'}" Classes="muted"/>
                                    <!-- Material "attach file" icon -->
                                    <PathIcon Grid.Column="5" Width="14" Height="14" HorizontalAlignment="Left"
                                              Foreground="{DynamicResource TextMutedBrush}"
                                              IsVisible="{Binding Expense.HasReceipt}"
                                              Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowPager}">
                                <Button Content="{loc:Tr TimeReports_PreviousPage}" Classes="subtle" Command="{Binding PreviousPageCommand}"/>
                                <TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center"/>
                                <Button Content="{loc:Tr TimeReports_NextPage}" Classes="subtle" Command="{Binding NextPageCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Tr TimeReports_ExportYear}" Classes="label" VerticalAlignment="Center"/>
                            <NumericUpDown Value="{Binding ExportYear}" Minimum="2000" Maximum="2100" Increment="1" FormatString="0" Width="130"/>
                            <Button Content="{loc:Tr Expenses_Export}" Classes="subtle" Command="{Binding ExportCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor / empty state -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>

                    <Border Classes="card" Padding="28" VerticalAlignment="Top"
                            IsVisible="{Binding ShowEmptyState}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <PathIcon Width="36" Height="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                      Data="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z"/>
                            <TextBlock Text="{loc:Tr Expenses_NoSelection}" Classes="h2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Expenses_NoSelectionHint}"
                                       Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
