<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:counts="using:Dotnetstore.PersonalApp.Modules.Products.Features.InventoryCounts"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.InventoryCounts.InventoryCountsView"
             x:DataType="counts:InventoryCountsViewModel">

    <Panel>
        <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="20"
              IsVisible="{Binding Screen, Converter={x:Static ObjectConverters.IsNull}}">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr InventoryCounts_Title}" Classes="h1"/>
                    <TextBlock Text="{loc:Tr InventoryCounts_Subtitle}" Classes="muted"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                        <TextBlock Text="{loc:Tr InventoryCounts_New}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,400" ColumnSpacing="20">

                <Border Classes="card" VerticalAlignment="Top">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                        <Border Padding="16,12" Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="32">
                                <Button Content="{loc:Tr InventoryCounts_OpenCount}" Classes="subtle" Command="{Binding OpenCommand}"/>
                                <Button Content="{loc:Tr InventoryCounts_Delete}" Classes="link-danger" Command="{Binding RequestDeleteCommand}"
                                        IsVisible="{Binding !IsConfirmingDelete}"/>
                                <TextBlock Text="{loc:Tr InventoryCounts_ConfirmDelete}" VerticalAlignment="Center" Classes="muted"
                                           IsVisible="{Binding IsConfirmingDelete}"/>
                                <Button Content="{loc:Tr InventoryCounts_YesDelete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                                        IsVisible="{Binding IsConfirmingDelete}"/>
                                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelDeleteCommand}"
                                        IsVisible="{Binding IsConfirmingDelete}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                            <Grid ColumnDefinitions="2*,1*,1.5*,1*,1*">
                                <TextBlock Text="{loc:Tr InventoryCounts_ColName}" Classes="column"/>
                                <TextBlock Grid.Column="1" Text="{loc:Tr InventoryCounts_ColDate}" Classes="column"/>
                                <TextBlock Grid.Column="2" Text="{loc:Tr InventoryCounts_ColLocation}" Classes="column"/>
                                <TextBlock Grid.Column="3" Text="{loc:Tr InventoryCounts_ColCounted}" Classes="column"/>
                                <TextBlock Grid.Column="4" Text="{loc:Tr InventoryCounts_ColStatus}" Classes="column"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="2" Classes="table" MinHeight="120" ItemsSource="{Binding Counts}" SelectedItem="{Binding SelectedCount}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="counts:InventoryCountRow">
                                    <Grid ColumnDefinitions="2*,1*,1.5*,1*,1*">
                                        <TextBlock Text="{Binding Count.Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DateText}" Classes="muted"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LocationText}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ProgressText}" Classes="muted"/>
                                        <TextBlock Grid.Column="4" Text="{Binding StatusText}" Classes="muted"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>

                        <Border Classes="card" Padding="28" VerticalAlignment="Top"
                                IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <!-- Material "fact check" icon -->
                                <PathIcon Width="36" Height="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                          Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-2h2v2zm0-4H7v-2h2v2zm0-4H7V7h2v2zm9 8h-7v-2h7v2zm0-4h-7v-2h7v2zm0-4h-7V7h7v2z"/>
                                <TextBlock Text="{loc:Tr InventoryCounts_NoSelection}" Classes="h2" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr InventoryCounts_NoSelectionHint}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <ContentControl Content="{Binding Screen}" Margin="28"/>
    </Panel>

</UserControl>
