<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:counts="using:Dotnetstore.PersonalApp.Modules.Products.Features.InventoryCounts"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="460"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.InventoryCounts.InventoryCountEditorView"
             x:DataType="counts:InventoryCountEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{loc:Tr InventoryCountEditor_Title}" Classes="h2"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr InventoryCountField_Name}" Classes="label"/>
                <TextBox Text="{Binding Name}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr InventoryCountField_Location}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="counts:CountLocationOption">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <CheckBox IsChecked="{Binding IncludeUnstocked}" IsEnabled="{Binding CanIncludeUnstocked}"
                      Content="{loc:Tr InventoryCountField_IncludeUnstocked}"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr InventoryCountField_Note}" Classes="label"/>
                <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr InventoryCountEditor_Start}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
