<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:counts="using:Dotnetstore.PersonalApp.Modules.Products.Features.InventoryCounts"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.InventoryCounts.InventoryCountScreenView"
             x:DataType="counts:InventoryCountScreenViewModel">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    <TextBlock Text="{loc:Tr InventoryCountScreen_Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Heading}" Classes="h2"/>
                <TextBlock Text="{loc:Tr InventoryCountScreen_Hint}" Classes="muted" IsVisible="{Binding IsOpen}"/>
                <TextBlock Text="{loc:Tr InventoryCountScreen_PostedHint}" Classes="muted" IsVisible="{Binding !IsOpen}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="1*,2*,1.4*,1.2*,1.4*,1*">
                        <TextBlock Text="{loc:Tr InventoryCountScreen_ColNumber}" Classes="column"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr InventoryCountScreen_ColProduct}" Classes="column"/>
                        <TextBlock Grid.Column="2" Text="{loc:Tr InventoryCountScreen_ColLocation}" Classes="column"/>
                        <TextBlock Grid.Column="3" Text="{loc:Tr InventoryCountScreen_ColExpected}" Classes="column"/>
                        <TextBlock Grid.Column="4" Text="{loc:Tr InventoryCountScreen_ColCounted}" Classes="column"/>
                        <TextBlock Grid.Column="5" Text="{loc:Tr InventoryCountScreen_ColDifference}" Classes="column"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="{loc:Tr InventoryCountScreen_Empty}" Classes="muted" Margin="16" TextWrapping="Wrap"
                           IsVisible="{Binding IsEmpty}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsEmpty}">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="counts:InventoryCountLineRow">
                                <Grid ColumnDefinitions="1*,2*,1.4*,1.2*,1.4*,1*" Margin="16,4">
                                    <TextBlock Text="{Binding Line.ProductNumber}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Line.ProductName}" Classes="muted" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Line.LocationName}" Classes="muted" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ExpectedText}" Classes="muted" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="4" Value="{Binding CountedQuantity}" Minimum="0" Maximum="1000000"
                                                   Increment="1" FormatString="0.##" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   IsEnabled="{Binding IsEditable}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding DifferenceText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOpen}">
                <Button Content="{loc:Tr InventoryCountScreen_Save}" Classes="subtle" Command="{Binding SaveCommand}"
                        IsVisible="{Binding !IsConfirmingPost}"/>
                <Button Content="{loc:Tr InventoryCountScreen_Post}" Classes="primary" Command="{Binding RequestPostCommand}"
                        IsVisible="{Binding !IsConfirmingPost}"/>
                <TextBlock Text="{loc:Tr InventoryCountScreen_ConfirmPost}" VerticalAlignment="Center" Classes="muted"
                           IsVisible="{Binding IsConfirmingPost}"/>
                <Button Content="{loc:Tr InventoryCountScreen_YesPost}" Classes="primary" Command="{Binding ConfirmPostCommand}"
                        IsVisible="{Binding IsConfirmingPost}"/>
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelPostCommand}"
                        IsVisible="{Binding IsConfirmingPost}"/>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
