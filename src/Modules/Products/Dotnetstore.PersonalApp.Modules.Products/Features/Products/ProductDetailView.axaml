<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:products="using:Dotnetstore.PersonalApp.Modules.Products.Features.Products"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.Products.ProductDetailView"
             x:DataType="products:ProductDetailViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20">

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    <TextBlock Text="{loc:Tr ProductDetail_Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Product.Name}" Classes="h2"/>
                <TextBlock Text="{Binding Product.Number}" Classes="muted"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" Content="{loc:Tr ProductDetail_Edit}" Command="{Binding EditCommand}"
                    VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" VerticalAlignment="Top">

                <!-- Photo and general information -->
                <Border Classes="card" Padding="28">
                    <StackPanel Spacing="18">
                        <ContentControl Content="{Binding Photo}" HorizontalAlignment="Left"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr ProductField_Kind}" Classes="label"/>
                                <TextBlock Text="{Binding KindLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Tr ProductDetail_Status}" Classes="label"/>
                                <TextBlock Text="{Binding StatusText}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="{loc:Tr ProductField_Category}" Classes="label"/>
                            <TextBlock Text="{Binding CategoryText}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24" IsVisible="{Binding IsHardware}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr ProductField_Manufacturer}" Classes="label"/>
                                <TextBlock Text="{Binding Product.Manufacturer}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Tr ProductField_Model}" Classes="label"/>
                                <TextBlock Text="{Binding Product.Model}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel IsVisible="{Binding IsSoftware}">
                            <TextBlock Text="{loc:Tr ProductField_Version}" Classes="label"/>
                            <TextBlock Text="{Binding Product.SoftwareVersion}"/>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsConsulting}">
                            <TextBlock Text="{loc:Tr ProductField_MinimumHours}" Classes="label"/>
                            <TextBlock Text="{Binding MinimumHoursText}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{loc:Tr ProductField_Description}" Classes="label"/>
                            <TextBlock Text="{Binding Product.Description}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="20">
                <!-- Pricing -->
                <Border Classes="card" Padding="28">
                    <StackPanel Spacing="18">
                        <TextBlock Text="{loc:Tr ProductDetail_Pricing}" Classes="h2"/>

                        <StackPanel>
                            <TextBlock Text="{loc:Tr ProductField_UnitPrice}" Classes="label"/>
                            <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr ProductDetail_PriceWithVat}" Classes="label"/>
                            <TextBlock Text="{Binding PriceWithVatText}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr ProductField_CostPrice}" Classes="label"/>
                            <TextBlock Text="{Binding CostText}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr ProductField_Vat}" Classes="label"/>
                            <TextBlock Text="{Binding VatText}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr ProductDetail_Margin}" Classes="label"/>
                            <TextBlock Text="{Binding MarginText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding StockCard}"/>
                <ContentControl Content="{Binding SupplierPriceList}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>
