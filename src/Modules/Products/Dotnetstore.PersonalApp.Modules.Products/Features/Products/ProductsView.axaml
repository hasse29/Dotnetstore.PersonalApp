<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:photos="using:Dotnetstore.PersonalApp.Shared.Photos"
             xmlns:products="using:Dotnetstore.PersonalApp.Modules.Products.Features.Products"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.Products.ProductsView"
             x:DataType="products:ProductsViewModel">

    <Panel>
    <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="20"
          IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}">

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Products_Title}" Classes="h1"/>
                <TextBlock Text="{loc:Tr Products_Subtitle}" Classes="muted"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                    <TextBlock Text="{loc:Tr Products_New}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,400" ColumnSpacing="20">

            <!-- Product table -->
            <Border Classes="card" VerticalAlignment="Top">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                    <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="8" Margin="16">
                        <TextBox Text="{Binding Search}" PlaceholderText="{loc:Tr Products_SearchPlaceholder}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FilterKinds}" SelectedItem="{Binding SelectedFilter}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="products:ProductKindOption">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" Content="{loc:Tr Products_Search}" Classes="subtle" Command="{Binding SearchCommand}"/>
                    </Grid>

                    <Border Grid.Row="1" Padding="16,0,16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="32">
                            <Button Content="{loc:Tr Products_Details}" Classes="subtle" Command="{Binding OpenDetailCommand}"/>
                            <Button Content="{loc:Tr Products_Delete}" Classes="link-danger" Command="{Binding RequestDeleteCommand}"
                                    IsVisible="{Binding !IsConfirmingDelete}"/>
                            <TextBlock Text="{loc:Tr Products_ConfirmDelete}" VerticalAlignment="Center" Classes="muted"
                                       IsVisible="{Binding IsConfirmingDelete}"/>
                            <Button Content="{loc:Tr Products_YesDelete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                                    IsVisible="{Binding IsConfirmingDelete}"/>
                            <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelDeleteCommand}"
                                    IsVisible="{Binding IsConfirmingDelete}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                        <Grid ColumnDefinitions="44,1*,2*,1.1*,1.2*,1.4*">
                            <TextBlock Grid.Column="1" Text="{loc:Tr Products_ColNumber}" Classes="column"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr Products_ColName}" Classes="column"/>
                            <TextBlock Grid.Column="3" Text="{loc:Tr Products_ColKind}" Classes="column"/>
                            <TextBlock Grid.Column="4" Text="{loc:Tr Products_ColCategory}" Classes="column"/>
                            <TextBlock Grid.Column="5" Text="{loc:Tr Products_ColPrice}" Classes="column"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="3" Classes="table" MinHeight="120" ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="products:ProductRow">
                                <Grid ColumnDefinitions="44,1*,2*,1.1*,1.2*,1.4*">
                                    <photos:AvatarView Size="32" HorizontalAlignment="Left" Initials="{Binding Initials}" Photo="{Binding Product.Thumbnail}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Product.Number}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Product.Name}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding KindLabel}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Product.CategoryName}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="5" Text="{Binding PriceText}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowPager}">
                                <Button Content="{loc:Tr Products_PreviousPage}" Classes="subtle" Command="{Binding PreviousPageCommand}"/>
                                <TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center"/>
                                <Button Content="{loc:Tr Products_NextPage}" Classes="subtle" Command="{Binding NextPageCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor / empty state -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>

                    <Border Classes="card" Padding="28" VerticalAlignment="Top"
                            IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <!-- Material "inventory 2" style box icon -->
                            <PathIcon Width="36" Height="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                      Data="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z"/>
                            <TextBlock Text="{loc:Tr Products_NoSelection}" Classes="h2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Products_NoSelectionHint}"
                                       Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>

    <ContentControl Content="{Binding Detail}" Margin="28"/>
    </Panel>

</UserControl>
