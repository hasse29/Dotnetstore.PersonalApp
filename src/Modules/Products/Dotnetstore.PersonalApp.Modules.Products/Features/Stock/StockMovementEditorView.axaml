<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:stock="using:Dotnetstore.PersonalApp.Modules.Products.Features.Stock"
             xmlns:locations="using:Dotnetstore.PersonalApp.Modules.Products.Features.StorageLocations"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="560"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.Stock.StockMovementEditorView"
             x:DataType="stock:StockMovementEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <StackPanel Spacing="2">
                <TextBlock Text="{loc:Tr StockEditor_Title}" Classes="h2"/>
                <TextBlock Text="{Binding Title}" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr StockEditor_Mode}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="stock:StockMovementModeOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{Binding LocationLabel}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="locations:StorageLocationDto">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsTransfer}">
                <TextBlock Text="{loc:Tr StockEditor_ToLocation}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedToLocation}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="locations:StorageLocationDto">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr StockEditor_Quantity}" Classes="label"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <NumericUpDown Value="{Binding Quantity}" Minimum="0" Maximum="1000000" Increment="1" FormatString="0.##"
                                   HorizontalAlignment="Stretch"/>
                    <TextBlock Grid.Column="1" Text="{Binding UnitLabel}" Classes="muted" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsReceipt}">
                <TextBlock Text="{loc:Tr StockEditor_Supplier}" Classes="label"/>
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="stock:SupplierOption">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr StockEditor_Note}" Classes="label"/>
                <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr StockEditor_Register}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
