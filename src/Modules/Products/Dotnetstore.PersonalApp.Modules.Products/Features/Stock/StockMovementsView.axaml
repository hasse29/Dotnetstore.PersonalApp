<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:stock="using:Dotnetstore.PersonalApp.Modules.Products.Features.Stock"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.Stock.StockMovementsView"
             x:DataType="stock:StockMovementsViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="20">

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr StockMovements_Title}" Classes="h1"/>
            <TextBlock Text="{loc:Tr StockMovements_Subtitle}" Classes="muted"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="card" VerticalAlignment="Top">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                <Grid ColumnDefinitions="*,200,Auto" ColumnSpacing="8" Margin="16">
                    <TextBox Text="{Binding Search}" PlaceholderText="{loc:Tr StockMovements_SearchPlaceholder}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilter}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="stock:StockMovementTypeOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="{loc:Tr StockMovements_Search}" Classes="subtle" Command="{Binding SearchCommand}"/>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                    <Grid ColumnDefinitions="1.2*,1.8*,1.2*,1.2*,0.8*,2*">
                        <TextBlock Text="{loc:Tr StockMovements_ColDate}" Classes="column"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr StockMovements_ColProduct}" Classes="column"/>
                        <TextBlock Grid.Column="2" Text="{loc:Tr StockMovements_ColLocation}" Classes="column"/>
                        <TextBlock Grid.Column="3" Text="{loc:Tr StockMovements_ColType}" Classes="column"/>
                        <TextBlock Grid.Column="4" Text="{loc:Tr StockMovements_ColQuantity}" Classes="column"/>
                        <TextBlock Grid.Column="5" Text="{loc:Tr StockMovements_ColDetails}" Classes="column"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="2" Classes="table" MinHeight="120" ItemsSource="{Binding Movements}" SelectionMode="Toggle">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="stock:StockMovementRow">
                            <Grid ColumnDefinitions="1.2*,1.8*,1.2*,1.2*,0.8*,2*">
                                <TextBlock Text="{Binding DateText}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Movement.ProductName}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Movement.LocationName}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding TypeText}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="4" Text="{Binding QuantityText}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="5" Text="{Binding DetailText}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowPager}">
                            <Button Content="{loc:Tr StockMovements_PreviousPage}" Classes="subtle" Command="{Binding PreviousPageCommand}"/>
                            <TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center"/>
                            <Button Content="{loc:Tr StockMovements_NextPage}" Classes="subtle" Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
