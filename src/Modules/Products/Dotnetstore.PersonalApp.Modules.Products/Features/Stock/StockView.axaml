<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:stock="using:Dotnetstore.PersonalApp.Modules.Products.Features.Stock"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.Stock.StockView"
             x:DataType="stock:StockViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="20">

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Stock_Title}" Classes="h1"/>
            <TextBlock Text="{loc:Tr Stock_Subtitle}" Classes="muted"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,400" ColumnSpacing="20">

            <Border Classes="card" VerticalAlignment="Top">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="16">
                        <TextBox Text="{Binding Search}" PlaceholderText="{loc:Tr Stock_SearchPlaceholder}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <CheckBox Grid.Column="1" IsChecked="{Binding LowOnly}" Content="{loc:Tr Stock_LowOnly}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="{loc:Tr Stock_Search}" Classes="subtle" Command="{Binding SearchCommand}"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                        <Grid ColumnDefinitions="1*,2*,1.2*,1*,1*">
                            <TextBlock Text="{loc:Tr Stock_ColNumber}" Classes="column"/>
                            <TextBlock Grid.Column="1" Text="{loc:Tr Stock_ColName}" Classes="column"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr Stock_ColInStock}" Classes="column"/>
                            <TextBlock Grid.Column="3" Text="{loc:Tr Stock_ColMinimum}" Classes="column"/>
                            <TextBlock Grid.Column="4" Text="{loc:Tr Stock_ColStatus}" Classes="column"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" Classes="table" MinHeight="120" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="stock:StockRow">
                                <Grid ColumnDefinitions="1*,2*,1.2*,1*,1*">
                                    <TextBlock Text="{Binding Item.Number}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Item.Name}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MinimumText}" Classes="muted"/>
                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" Classes="error"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowPager}">
                                <Button Content="{loc:Tr Stock_PreviousPage}" Classes="subtle" Command="{Binding PreviousPageCommand}"/>
                                <TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center"/>
                                <Button Content="{loc:Tr Stock_NextPage}" Classes="subtle" Command="{Binding NextPageCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>

                    <Border Classes="card" Padding="28" VerticalAlignment="Top"
                            IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <!-- Material "inventory" icon -->
                            <PathIcon Width="36" Height="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                      Data="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z"/>
                            <TextBlock Text="{loc:Tr Stock_NoSelection}" Classes="h2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Stock_NoSelectionHint}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
