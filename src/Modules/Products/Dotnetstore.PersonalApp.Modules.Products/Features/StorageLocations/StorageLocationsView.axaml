<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:locations="using:Dotnetstore.PersonalApp.Modules.Products.Features.StorageLocations"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.StorageLocations.StorageLocationsView"
             x:DataType="locations:StorageLocationsViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="20">

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr StorageLocations_Title}" Classes="h1"/>
                <TextBlock Text="{loc:Tr StorageLocations_Subtitle}" Classes="muted"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                    <TextBlock Text="{loc:Tr StorageLocations_New}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,380" ColumnSpacing="20">

            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16">
                        <TextBox Text="{Binding Search}" PlaceholderText="{loc:Tr StorageLocations_SearchPlaceholder}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="{loc:Tr StorageLocations_Search}" Classes="subtle" Command="{Binding LoadCommand}"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                        <Grid ColumnDefinitions="*,2*,1*">
                            <TextBlock Text="{loc:Tr StorageLocations_ColName}" Classes="column"/>
                            <TextBlock Grid.Column="1" Text="{loc:Tr StorageLocations_ColDescription}" Classes="column"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr StorageLocations_ColStatus}" Classes="column"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" Classes="table" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="locations:StorageLocationRow">
                                <Grid ColumnDefinitions="*,2*,1*">
                                    <TextBlock Text="{Binding Location.Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Location.Description}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="muted"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Tr StorageLocations_Delete}" Classes="link-danger" Command="{Binding RequestDeleteCommand}"
                                        IsVisible="{Binding !IsConfirmingDelete}"/>
                                <TextBlock Text="{loc:Tr StorageLocations_ConfirmDelete}" VerticalAlignment="Center" Classes="muted"
                                           IsVisible="{Binding IsConfirmingDelete}"/>
                                <Button Content="{loc:Tr StorageLocations_YesDelete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                                        IsVisible="{Binding IsConfirmingDelete}"/>
                                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelDeleteCommand}"
                                        IsVisible="{Binding IsConfirmingDelete}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>

                    <Border Classes="card" Padding="28" VerticalAlignment="Top"
                            IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <!-- Material "warehouse" icon -->
                            <PathIcon Width="36" Height="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                      Data="M22 21V7L12 3 2 7v14h5v-9h10v9h5zm-13 0v-2h6v2H9zm0-4v-2h6v2H9z"/>
                            <TextBlock Text="{loc:Tr StorageLocations_NoSelection}" Classes="h2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr StorageLocations_NoSelectionHint}"
                                       Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
