<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:locations="using:Dotnetstore.PersonalApp.Modules.Products.Features.StorageLocations"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="400"
             x:Class="Dotnetstore.PersonalApp.Modules.Products.Features.StorageLocations.StorageLocationEditorView"
             x:DataType="locations:StorageLocationEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr StorageLocationField_Name}" Classes="label"/>
                <TextBox Text="{Binding Name}" PlaceholderText="{loc:Tr StorageLocationField_NamePlaceholder}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr StorageLocationField_Description}" Classes="label"/>
                <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="140"/>
            </StackPanel>

            <CheckBox IsChecked="{Binding IsActive}" Content="{loc:Tr StorageLocationField_Active}"/>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr StorageLocationEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
