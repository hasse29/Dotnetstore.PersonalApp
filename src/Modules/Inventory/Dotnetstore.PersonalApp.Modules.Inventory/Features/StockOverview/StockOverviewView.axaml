<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:feat="using:Dotnetstore.PersonalApp.Modules.Inventory.Features"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Inventory.Features.StockOverview"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Inventory.Features.StockOverview.StockOverviewView"
             x:DataType="vm:StockOverviewViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="20">

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr StockOverview_Title}" Classes="h1"/>
            <TextBlock Text="{loc:Tr StockOverview_Subtitle}" Classes="muted"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="card">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,220,Auto,Auto" ColumnSpacing="8" Margin="16">
                    <TextBox Text="{Binding Search}" PlaceholderText="{loc:Tr StockOverview_SearchPlaceholder}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="feat:OptionDto">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Column="2" IsChecked="{Binding OnlyLow}" Content="{loc:Tr StockOverview_OnlyLow}" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="{loc:Tr StockOverview_Search}" Classes="subtle" Command="{Binding LoadCommand}"/>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                    <Grid ColumnDefinitions="2*,*,*,*,*,Auto">
                        <TextBlock Text="{loc:Tr StockOverview_ColProduct}" Classes="column"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr StockOverview_ColWarehouse}" Classes="column"/>
                        <TextBlock Grid.Column="2" Text="{loc:Tr StockOverview_ColLocation}" Classes="column"/>
                        <TextBlock Grid.Column="3" Text="{loc:Tr StockOverview_ColQuantity}" Classes="column"/>
                        <TextBlock Grid.Column="4" Text="{loc:Tr StockOverview_ColMinQuantity}" Classes="column"/>
                        <TextBlock Grid.Column="5" Width="60"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="2" Classes="table" ItemsSource="{Binding Rows}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:StockOverviewRow">
                            <Grid ColumnDefinitions="2*,*,*,*,*,Auto">
                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding WarehouseName}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding LocationCode}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Quantity, StringFormat={}{0:N2}}"/>
                                <TextBlock Grid.Column="4" Text="{Binding MinQuantity, StringFormat={}{0:N2}}" Classes="muted"/>
                                <TextBlock Grid.Column="5" Width="60" Text="{loc:Tr StockOverview_Low}" Classes="error" IsVisible="{Binding IsLow}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
