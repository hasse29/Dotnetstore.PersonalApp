<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Inventory.Features.Receiving"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Inventory.Features.Receiving.GoodsIssueView"
             x:DataType="vm:GoodsIssueViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="20">
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr GoodsIssue_Title}" Classes="h1"/>
            <TextBlock Text="{Binding Subtitle}" Classes="muted"/>
        </StackPanel>

        <vm:GoodsMovementPanel Grid.Row="1"/>
    </Grid>

</UserControl>
