<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:feat="using:Dotnetstore.PersonalApp.Modules.Inventory.Features"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Inventory.Features.Receiving"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.Inventory.Features.Receiving.GoodsMovementPanel"
             x:DataType="vm:GoodsMovementViewModel">

    <Grid>
        <Border Classes="card" Padding="28" IsVisible="{Binding !HasOrders}">
            <TextBlock Text="{loc:Tr GoodsMovement_NoOrderModule}" Classes="muted" TextWrapping="Wrap"/>
        </Border>

        <Border Classes="card" IsVisible="{Binding HasOrders}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="16" Margin="16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr GoodsMovement_Order}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="feat:OptionDto">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Tr GoodsMovement_Location}" Classes="label"/>
                        <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="feat:OptionDto">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                    <Grid ColumnDefinitions="2*,*,*,*,*">
                        <TextBlock Text="{loc:Tr GoodsMovement_ColProduct}" Classes="column"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr GoodsMovement_ColOrdered}" Classes="column"/>
                        <TextBlock Grid.Column="2" Text="{Binding HandledText}" Classes="column"/>
                        <TextBlock Grid.Column="3" Text="{loc:Tr GoodsMovement_ColOutstanding}" Classes="column"/>
                        <TextBlock Grid.Column="4" Text="{loc:Tr GoodsMovement_ColQuantity}" Classes="column"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderLineRow">
                                <Grid ColumnDefinitions="2*,*,*,*,*" Margin="16,8">
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Ordered, StringFormat={}{0:N2}}" Classes="muted" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Handled, StringFormat={}{0:N2}}" Classes="muted" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Outstanding, StringFormat={}{0:N2}}" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="4" Value="{Binding Quantity}" Minimum="0" Increment="1" FormatString="0.00" ShowButtonSpinner="False" Margin="0,0,16,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty} }"/>
                            <TextBlock Text="{Binding StatusMessage}" Classes="caption"
                                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty} }"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding ConfirmText}" Classes="primary" Command="{Binding ConfirmCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
