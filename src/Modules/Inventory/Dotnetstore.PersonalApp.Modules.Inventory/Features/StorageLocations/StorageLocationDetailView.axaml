<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Inventory.Features.StorageLocations"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Inventory.Features.StorageLocations.StorageLocationDetailView"
             x:DataType="vm:StorageLocationDetailViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    <TextBlock Text="{loc:Tr StorageLocationDetail_Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Location.Code}" Classes="h2"/>
                <TextBlock Text="{Binding Location.WarehouseName}" Classes="muted"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Padding="0">
            <TabItem Header="{loc:Tr StorageLocationDetail_TabInformation}">
                <Border Classes="card" Padding="28" Margin="0,20,0,0" VerticalAlignment="Top">
                    <WrapPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr StorageLocationField_Warehouse}" Classes="label"/>
                            <TextBlock Text="{Binding Location.WarehouseName}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr StorageLocationField_Code}" Classes="label"/>
                            <TextBlock Text="{Binding Location.Code}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr StorageLocationField_Zone}" Classes="label"/>
                            <TextBlock Text="{Binding Location.Zone}"/>
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr StorageLocationField_Capacity}" Classes="label"/>
                            <TextBlock Text="{Binding Location.Capacity, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                        <StackPanel Width="540" Margin="0,0,16,14">
                            <TextBlock Text="{loc:Tr StorageLocationField_Description}" Classes="label"/>
                            <TextBlock Text="{Binding Location.Description}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </TabItem>

            <TabItem Header="{loc:Tr StorageLocationDetail_TabContents}">
                <ContentControl Content="{Binding Contents}" Margin="0,20,0,0"/>
            </TabItem>
            <TabItem Header="{loc:Tr StorageLocationDetail_TabMovements}">
                <ContentControl Content="{Binding Movements}" Margin="0,20,0,0"/>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
