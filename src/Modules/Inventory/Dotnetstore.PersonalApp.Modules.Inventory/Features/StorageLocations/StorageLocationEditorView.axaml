<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:feat="using:Dotnetstore.PersonalApp.Modules.Inventory.Features"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Inventory.Features.StorageLocations"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.Inventory.Features.StorageLocations.StorageLocationEditorView"
             x:DataType="vm:StorageLocationEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel IsVisible="{Binding !IsParentFixed}">
                <TextBlock Text="{loc:Tr StorageLocationField_Warehouse}" Classes="label"/>
                <ComboBox ItemsSource="{Binding WarehouseOptions}" SelectedItem="{Binding SelectedWarehouse}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr StorageLocationField_Code}" Classes="label"/>
                <TextBox Text="{Binding Code}" MaxLength="30"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr StorageLocationField_Zone}" Classes="label"/>
                <TextBox Text="{Binding Zone}" MaxLength="50"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr StorageLocationField_Description}" Classes="label"/>
                <TextBox Text="{Binding Description}" MaxLength="200"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr StorageLocationField_Capacity}" Classes="label"/>
                <NumericUpDown Value="{Binding Capacity}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty} }"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr StorageLocationEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>