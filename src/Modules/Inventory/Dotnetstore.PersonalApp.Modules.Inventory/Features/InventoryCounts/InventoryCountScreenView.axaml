<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Inventory.Features.InventoryCounts"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Dotnetstore.PersonalApp.Modules.Inventory.Features.InventoryCounts.InventoryCountScreenView"
             x:DataType="vm:InventoryCountScreenViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="20">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Classes="subtle" Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                    <TextBlock Text="{loc:Tr InventoryCountScreen_Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Current.Number}" Classes="h2"/>
                <TextBlock Text="{Binding Current.WarehouseName}" Classes="muted"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="380,*" ColumnSpacing="20">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="16">

                <Border Classes="card" Padding="20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Tr InventoryCountScreen_Posted}" Classes="caption"
                                       IsVisible="{Binding Current.Posted}"/>
                            <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty} }"/>
                            <TextBlock Text="{Binding StatusMessage}" Classes="caption"
                                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty} }"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Tr InventoryCountScreen_Fill}" Classes="subtle" Command="{Binding FillCommand}"/>
                            <Button Content="{loc:Tr InventoryCountScreen_Post}" Classes="primary" Command="{Binding PostCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="{loc:Tr InventoryCountScreen_Lines}" Classes="h2"/>

                <ContentControl Grid.Row="2" Content="{Binding Lines}"/>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
