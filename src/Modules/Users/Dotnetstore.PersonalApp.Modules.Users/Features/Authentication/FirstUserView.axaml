<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:auth="using:Dotnetstore.PersonalApp.Modules.Users.Features.Authentication"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Dotnetstore.PersonalApp.Modules.Users.Features.Authentication.FirstUserView"
             x:DataType="auth:FirstUserViewModel">

    <Grid ColumnDefinitions="1.1*,*">

        <Border Background="{DynamicResource BrandGradientBrush}" Padding="56">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#26FFFFFF">
                        <PathIcon Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </Border>
                    <TextBlock Text="PersonalApp" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="14">
                    <TextBlock Text="{loc:Tr Setup_Hero}" Foreground="White" FontSize="38" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Tr Setup_HeroText}"
                               Foreground="#D9FFFFFF" FontSize="16" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Dotnetstore" Foreground="#99FFFFFF" FontSize="12"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
        <ScrollViewer>
            <StackPanel Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Margin="0,32">
                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <TextBlock Text="{loc:Tr Setup_Title}" Classes="h1"/>
                    <TextBlock Text="{loc:Tr Setup_Subtitle}" Classes="muted"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Field_FirstName}" Classes="label"/>
                        <TextBox Text="{Binding FirstName}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Tr Field_LastName}" Classes="label"/>
                        <TextBox Text="{Binding LastName}"/>
                    </StackPanel>
                </Grid>

                <StackPanel>
                    <TextBlock Text="{loc:Tr Field_Username}" Classes="label"/>
                    <TextBox Text="{Binding Username}" PlaceholderText="{loc:Tr Field_UsernamePlaceholder}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{loc:Tr Field_Password}" Classes="label"/>
                    <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="{loc:Tr Setup_PasswordPlaceholder}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{loc:Tr Field_ConfirmPassword}" Classes="label"/>
                    <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{loc:Tr Field_DateOfBirth}" Classes="label"/>
                    <CalendarDatePicker SelectedDate="{Binding DateOfBirth}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <Button Content="{loc:Tr Setup_Create}" Command="{Binding CreateCommand}" IsDefault="True" Classes="primary"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12"/>
            </StackPanel>
        </ScrollViewer>
        <loc:LanguageComboBox HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24"/>
        </Grid>
    </Grid>

</UserControl>
