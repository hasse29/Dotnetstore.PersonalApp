<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:photos="using:Dotnetstore.PersonalApp.Shared.Photos"
             xmlns:users="using:Dotnetstore.PersonalApp.Modules.Users.Features.Users"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
             x:Class="Dotnetstore.PersonalApp.Modules.Users.Features.Users.UsersView"
             x:DataType="users:UsersViewModel">

    <Panel>
    <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="20"
          IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}">

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Users_Title}" Classes="h1"/>
                <TextBlock Text="{loc:Tr Users_Subtitle}" Classes="muted"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                    <TextBlock Text="{loc:Tr Users_New}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,380" ColumnSpacing="20">

            <!-- User table -->
            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16">
                        <TextBox Text="{Binding Search}" PlaceholderText="{loc:Tr Users_SearchPlaceholder}"/>
                        <Button Grid.Column="1" Content="{loc:Tr Users_Search}" Classes="subtle" Command="{Binding LoadCommand}"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" Padding="16,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1">
                        <Grid ColumnDefinitions="32,2*,2*,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="1" Text="{loc:Tr Users_ColName}" Classes="column"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr Users_ColUsername}" Classes="column"/>
                            <TextBlock Grid.Column="3" Text="{loc:Tr Users_ColBorn}" Classes="column"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" Classes="table" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="users:UserDto">
                                <Grid ColumnDefinitions="32,2*,2*,*" ColumnSpacing="12">
                                    <photos:AvatarView Size="32" Initials="{Binding Initials}" Photo="{Binding Thumbnail}"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding FullName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Username}" Classes="muted"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding DateOfBirth, StringFormat='{}{0:yyyy-MM-dd}'}" Classes="muted"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Tr Users_Details}" Classes="subtle" Command="{Binding OpenDetailCommand}"
                                        IsVisible="{Binding !IsConfirmingDelete}"/>
                                <Button Content="{loc:Tr Users_Delete}" Classes="link-danger" Command="{Binding RequestDeleteCommand}"
                                        IsVisible="{Binding !IsConfirmingDelete}"/>
                                <TextBlock Text="{loc:Tr Users_ConfirmDelete}" VerticalAlignment="Center" Classes="muted"
                                           IsVisible="{Binding IsConfirmingDelete}"/>
                                <Button Content="{loc:Tr Users_YesDelete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                                        IsVisible="{Binding IsConfirmingDelete}"/>
                                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelDeleteCommand}"
                                        IsVisible="{Binding IsConfirmingDelete}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor / empty state -->
            <Grid Grid.Column="1" RowDefinitions="Auto">
                <ContentControl Content="{Binding Editor}" VerticalAlignment="Top"/>

                <Border Classes="card" Padding="28" VerticalAlignment="Top"
                        IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <PathIcon Width="36" Height="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                  Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                        <TextBlock Text="{loc:Tr Users_NoSelection}" Classes="h2" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Users_NoSelectionHint}"
                                   Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>

    <ContentControl Content="{Binding Detail}"/>
    </Panel>

</UserControl>
