<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:feat="using:Dotnetstore.PersonalApp.Modules.Production.Features"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Production.Features.ProductReviews"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.Production.Features.ProductReviews.ProductReviewEditorView"
             x:DataType="vm:ProductReviewEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel IsVisible="{Binding !IsParentFixed}">
                <TextBlock Text="{loc:Tr ProductReviewField_Product}" Classes="label"/>
                <ComboBox ItemsSource="{Binding ProductOptions}" SelectedItem="{Binding SelectedProduct}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductReviewField_ReviewerName}" Classes="label"/>
                <TextBox Text="{Binding ReviewerName}" MaxLength="50"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductReviewField_ReviewDate}" Classes="label"/>
                <CalendarDatePicker SelectedDate="{Binding ReviewDate}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductReviewField_EmailAddress}" Classes="label"/>
                <TextBox Text="{Binding EmailAddress}" MaxLength="50"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductReviewField_Rating}" Classes="label"/>
                <NumericUpDown Value="{Binding Rating}" Minimum="1" Maximum="5" Increment="1" FormatString="0" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductReviewField_Comments}" Classes="label"/>
                <TextBox Text="{Binding Comments}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160" MaxLength="3850"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty} }"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr ProductReviewEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>