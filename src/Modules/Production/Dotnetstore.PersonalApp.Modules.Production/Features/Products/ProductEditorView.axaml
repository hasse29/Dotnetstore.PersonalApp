<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:feat="using:Dotnetstore.PersonalApp.Modules.Production.Features"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dotnetstore.PersonalApp.Modules.Production.Features.Products"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="520"
             x:Class="Dotnetstore.PersonalApp.Modules.Production.Features.Products.ProductEditorView"
             x:DataType="vm:ProductEditorViewModel">

    <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="h2"/>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_Name}" Classes="label"/>
                <TextBox Text="{Binding Name}" MaxLength="50"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_ProductNumber}" Classes="label"/>
                <TextBox Text="{Binding ProductNumber}" MaxLength="25"/>
            </StackPanel>

            <StackPanel>
                <CheckBox IsChecked="{Binding MakeFlag}" Content="{loc:Tr ProductField_MakeFlag}"/>
            </StackPanel>

            <StackPanel>
                <CheckBox IsChecked="{Binding FinishedGoodsFlag}" Content="{loc:Tr ProductField_FinishedGoodsFlag}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_Color}" Classes="label"/>
                <TextBox Text="{Binding Color}" MaxLength="15"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_SafetyStockLevel}" Classes="label"/>
                <NumericUpDown Value="{Binding SafetyStockLevel}" Minimum="0" Maximum="1000000" Increment="1" FormatString="0" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_ReorderPoint}" Classes="label"/>
                <NumericUpDown Value="{Binding ReorderPoint}" Minimum="0" Maximum="1000000" Increment="1" FormatString="0" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_StandardCost}" Classes="label"/>
                <NumericUpDown Value="{Binding StandardCost}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_ListPrice}" Classes="label"/>
                <NumericUpDown Value="{Binding ListPrice}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_Size}" Classes="label"/>
                <TextBox Text="{Binding Size}" MaxLength="5"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_SizeUnit}" Classes="label"/>
                <ComboBox ItemsSource="{Binding SizeUnitOptions}" SelectedItem="{Binding SelectedSizeUnit}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_Weight}" Classes="label"/>
                <NumericUpDown Value="{Binding Weight}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.00" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_WeightUnit}" Classes="label"/>
                <ComboBox ItemsSource="{Binding WeightUnitOptions}" SelectedItem="{Binding SelectedWeightUnit}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_DaysToManufacture}" Classes="label"/>
                <NumericUpDown Value="{Binding DaysToManufacture}" Minimum="0" Maximum="365" Increment="1" FormatString="0" ShowButtonSpinner="False"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_ProductLine}" Classes="label"/>
                <ComboBox ItemsSource="{Binding ProductLineOptions}" SelectedItem="{Binding SelectedProductLine}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:ChoiceOption">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_Class}" Classes="label"/>
                <ComboBox ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClass}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:ChoiceOption">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_Style}" Classes="label"/>
                <ComboBox ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyle}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:ChoiceOption">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_Subcategory}" Classes="label"/>
                <ComboBox ItemsSource="{Binding SubcategoryOptions}" SelectedItem="{Binding SelectedSubcategory}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_Model}" Classes="label"/>
                <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="feat:OptionDto">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_SellStartDate}" Classes="label"/>
                <CalendarDatePicker SelectedDate="{Binding SellStartDate}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_SellEndDate}" Classes="label"/>
                <CalendarDatePicker SelectedDate="{Binding SellEndDate}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{loc:Tr ProductField_DiscontinuedDate}" Classes="label"/>
                <CalendarDatePicker SelectedDate="{Binding DiscontinuedDate}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty} }"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Classes="subtle" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Tr ProductEditor_Save}" Classes="primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>