<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Dotnetstore.PersonalApp.Shared.Localization"
             xmlns:photos="using:Dotnetstore.PersonalApp.Shared.Photos"
             x:Class="Dotnetstore.PersonalApp.Shared.Photos.PhotoPanelView"
             x:DataType="photos:PhotoPanelViewModel">

    <UserControl.Resources>
        <photos:BytesToBitmapConverter x:Key="PhotoConverter"/>
    </UserControl.Resources>

    <StackPanel Spacing="12" HorizontalAlignment="Center">
        <Panel Width="112" Height="112">
            <Border Classes="avatar" Width="112" Height="112" CornerRadius="56" IsVisible="{Binding HasNoPhoto}">
                <TextBlock Text="{Binding Initials}" FontSize="40"/>
            </Border>
            <Border Width="112" Height="112" CornerRadius="56" ClipToBounds="True" IsVisible="{Binding !HasNoPhoto}">
                <Image Source="{Binding Photo, Converter={StaticResource PhotoConverter}}" Stretch="UniformToFill"/>
            </Border>
        </Panel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="subtle" Content="{loc:Tr Photo_Change}" Command="{Binding ChoosePhotoCommand}"/>
            <Button Classes="link-danger" Content="{loc:Tr Photo_Remove}" Command="{Binding RemovePhotoCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="error" TextWrapping="Wrap" TextAlignment="Center"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

</UserControl>
